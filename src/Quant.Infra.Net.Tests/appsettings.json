{
    // ============================================================================
    // Quant.Infra.Net Unit Test Configuration (appsettings.json)
    // 测试配置文件
    // 
    // IMPORTANT: Never store API keys or passwords here! Use dotnet user-secrets instead.
    // 敏感信息请使用 dotnet user-secrets 存储，详见 Manual.md#configuration-guide：
    // https://github.com/memoryfraction/Quant.Infra.Net/blob/main/Manual.md#configuration-guide
    //
    // Quick Reference — each section links to the corresponding Manual.md chapter:
    //   Robot & StrategyParameters   -> Manual.md#getting-started
    //   Notification                 -> Manual.md#notification-module
    //   Email / BrevoEmail           -> Manual.md#notification-module
    //   Alpaca                       -> Manual.md#broker-module
    //   Binance                      -> Manual.md#broker-module
    //   Schwab                       -> Manual.md#broker-module
    //   CoinMarketCap                -> Manual.md#data-source-module
    // ============================================================================

    // ------------------------------------------------------------------------
    // Robot: Global trading bot switch
    // 文档: Manual.md#getting-started (Getting Started)
    // ------------------------------------------------------------------------
    "Robot": {
        "Mode": "Test",              // "Test" = notifications only, no real orders; "LiveTrade" = real orders (DANGER!)
        "SelfCheck": {
            "Enable": true,          // Enable startup self-check + periodic check
            "Interval": 300,         // Self-check interval in seconds (default: 300s = 5 min)
            "HeartBeat": {
                "Enable": true,      // Send heartbeat packets
                "Interval": 30       // Heartbeat interval in seconds (detect frozen process)
            }
        }
    },

    // ------------------------------------------------------------------------
    // StrategyParameters: Signal generation parameters
    // 文档: Manual.md#getting-started (Getting Started)
    // ------------------------------------------------------------------------
    "StrategyParameters": {
        "DataSource": "YahooFinance",   // Options: "YahooFinance" | "Binance" | "Alpaca"
        "Symbol": "BTC-USD",           // Yahoo Finance symbol, e.g. "AAPL", "BTC-USD"
        "Period": "Weekly",            // Signal period: "Daily", "Weekly", "Monthly"
        "DayOfWeek": "",              // Specific trigger day (empty = no restriction)
        "CanSell": true,              // Allow sell signals
        "SimpleMovingAverageDays": "", // Moving average window, e.g. "20", "50", "200"
        "Region": "",                // Region filter
        "Step": "",                 // Step parameter
        "InvestCashWeekly": 500.0,   // Weekly investment amount (USD)
        "MustEntireShare": false     // Require whole-share trading
    },

    // ------------------------------------------------------------------------
    // Notification: Notification channel configuration
    // 文档: Manual.md#notification-module (Notification Module)
    // Store secrets with user-secrets:
    //   dotnet user-secrets set "Notification:WeChatRobotWebHook" "https://qyapi.weixin..."
    //   dotnet user-secrets set "Notification:DingTalk:accessToken" "your-token"
    //   dotnet user-secrets set "Notification:DingTalk:secret" "SECxxxxx"
    // ------------------------------------------------------------------------
    "Notification": {
        "Mode": "WeChat",           // Channel: "WeChat" | "DingTalk" | "Email"

        // WeChat Work Robot WebHook — for NotificationTests.SendWeChatRobotNotification_Should_Work
        // How to get: Group Chat -> Settings -> Group Robots -> Add Robot -> copy WebHook URL
        // Example: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx"
        "WeChatRobotWebHook": "",

        // DingTalk Robot — for NotificationTests.DingTalkSendNotification_Should_Work
        // How to get: DingTalk Group -> Settings -> Smart Assistant -> Add Robot -> Custom (Webhook)
        // accessToken example: "https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx"
        // secret example: "SECxxxxxxxxxxxxxxxxxxxxxxxx" (required for signature mode)
        "DingTalk": {
            "accessToken": "",       // DingTalk WebHook URL or access_token
            "secret": ""             // Signing secret (required if signature verification is enabled)
        },

        // Email notification (legacy path, used by some code)
        "Email": {
            "SmtpServer": "smtp.126.com",
            "Port": 465,
            "SenderEmail": "your-email@126.com",
            "Password": "",          // SMTP authorization code (not login password), use user-secrets!
            "SenderName": "Quant Bot"
        },

        // Brevo (formerly Sendinblue) commercial email — for EmailIntegrationTests.MVP_SendCommercial
        // Sign up: https://www.brevo.com (free tier: 300 emails/day)
        // Password must be xsmtpsib-xxx format (SMTP-specific password, NOT the API key)
        "BrevoEmail": {
            "SmtpServer": "smtp-relay.brevo.com",
            "Port": 587,
            "SenderEmail": "your-sender@domain.com",
            "Username": "",          // Brevo sender email
            "Password": "",          // SMTP password: xsmtpsib-xxxxxxxx (get from Brevo dashboard)
            "SenderName": "Quant Lab"
        }
    },

    // ------------------------------------------------------------------------
    // CoinMarketCap: Crypto market-cap data API
    // 文档: Manual.md#data-source-module (Data Source Module)
    // Store with user-secrets: dotnet user-secrets set "CoinMarketCap:ApiKey" "xxxxxxx-xxxx-xxxx"
    // Register: https://coinmarketcap.com/api/pricing/
    // ------------------------------------------------------------------------
    "CoinMarketCap": {
        "BaseUrl": "https://pro-api.coinmarketcap.com",
        "ApiKey": ""                 // CoinMarketCap API Key (free tier: 10,000 req/month)
    },

    // ------------------------------------------------------------------------
    // Email (DI container): for EmailIntegrationTests (2 test methods)
    // 文档: Manual.md#notification-module — Email Notifications section
    // Store passwords with user-secrets:
    //   dotnet user-secrets set "Email:Personal:Password" "your-smtp-password"
    //   dotnet user-secrets set "Email:Commercial:Password" "xsmtpsib-xxx"
    // ------------------------------------------------------------------------
    "Email": {
        // Personal email — for EmailIntegrationTests.MVP_PersonalSendTest_ViaFactory
        "Personal": {
            "SmtpServer": "smtp.126.com",   // SMTP server (QQ: smtp.qq.com, Gmail: smtp.gmail.com)
            "Port": "465",                  // SSL port: 465; TLS port: 587
            "SenderEmail": "your-email@126.com",
            "SenderName": "Quant Bot",
            "Password": ""                  // SMTP auth code (enable IMAP/SMTP in email settings first)
        },
        // Commercial email (Brevo) — for EmailIntegrationTests.MVP_SendCommercial
        "Commercial": {
            "SmtpServer": "smtp-relay.brevo.com",
            "Port": "587",
            "SenderEmail": "your-sender@domain.com",
            "SenderName": "AlphaWealthLab",
            "Password": ""                  // Brevo SMTP password (xsmtpsib-xxx format)
        }
    },

    // ------------------------------------------------------------------------
    // Schwab: Charles Schwab broker API (US equity)
    // 文档: Manual.md#broker-module — Charles Schwab section
    // Store with user-secrets:
    //   dotnet user-secrets set "Schwab:ApiKey" "your-api-key"
    //   dotnet user-secrets set "Schwab:Secret" "your-client-secret"
    //   dotnet user-secrets set "Schwab:AccountNumber" "abc12345"
    // Register: https://developer.schwab.com/
    // ------------------------------------------------------------------------
    "Schwab": {
        "ApiKey": "",                 // Schwab API Key (Client ID from Developer Portal)
        "Secret": "",                 // Client Secret
        "AccountNumber": "",          // Your Schwab account number
        "BaseUrl": "https://api.schwabapi.com/trader/v1"
    },

    // ------------------------------------------------------------------------
    // Alpaca: US equity broker API (paper / live trading)
    // 文档: Manual.md#broker-module — Alpaca section
    // Store with user-secrets:
    //   dotnet user-secrets set "Alpaca:ApiKey" "PAxxxxxxxxxxxxxxxx"
    //   dotnet user-secrets set "Alpaca:ApiSecret" "xxxxxxxxxxxxxxxxxxxxx"
    // Register: https://alpaca.markets (Paper environment is free & unlimited)
    // Environment: "Paper" = simulated trading (recommended); "Live" = real trading (DANGER!)
    // ------------------------------------------------------------------------
    "Alpaca": {
        "ApiKey": "",                // Alpaca API Key (format: PAxxxxxxxx...)
        "ApiSecret": "",             // Alpaca API Secret
        "Environment": "Paper"       // "Paper" = simulated; "Live" = real trading
    },

    // ------------------------------------------------------------------------
    // Binance: Crypto exchange API
    // 文档: Manual.md#broker-module — Binance Futures section
    // Store with user-secrets:
    //   dotnet user-secrets set "Binance:ApiKey" "your-api-key"
    //   dotnet user-secrets set "Binance:ApiSecret" "your-api-secret"
    // Register: https://www.binance.com -> User Center -> API Management
    // Environment: "Testnet" = test network (recommended); "Live" = real trading (DANGER!)
    // Testnet keys: https://testnet.binance.vision/ (separate registration)
    // Note from mainland China: you need a proxy/VPN, otherwise the API will fail
    // ------------------------------------------------------------------------
    "Binance": {
        "ApiKey": "",                // Binance API Key
        "ApiSecret": "",             // Binance API Secret
        "Environment": "Testnet"     // "Testnet" = test network; "Live" = real trading
    }
}
